#!/usr/bin/env bash
# Assert the bundled GTK resolves against the distro's stock stack and nothing else.
#
# This is the whole reason the bundle is 4.16 and not 4.18: 4.18 wants pango >= 1.56,
# which wants glib >= 2.82, neither of which Mint ships. Bundling GTK is cheap; bundling
# glib and pango behind it is a different project. This script enforces that constraint on
# every build.
#
# Passes when every library the bundle needs resolves to a file some dpkg package owns.
# That is the precise statement of "stock": a hand-built glib sitting in /usr/local, or a
# second bundle's directory on the path, is owned by nothing and fails here.
#
#   scripts/check-no-cascade build/gtk/prefix/lib/libgtk-4.so.1
set -uo pipefail

LIB=${1:?usage: check-no-cascade <path-to-libgtk-4.so.1>}
[ -e "$LIB" ] || { echo "check-no-cascade: no such file: $LIB" >&2; exit 1; }

# The bundle's own directory is not a foreign dependency. Resolve it so a sibling .so
# in the same prefix is not mistaken for one.
BUNDLE_DIR=$(cd "$(dirname "$(readlink -f "$LIB")")" && pwd)

fail=0
note() { printf '  %s\n' "$1"; }

out=$(ldd "$LIB" 2>/dev/null) || { echo "check-no-cascade: ldd failed on $LIB" >&2; exit 1; }

# 1. Nothing unresolved. A "not found" here is a bundle that will not start.
if missing=$(grep "not found" <<<"$out"); then
	echo "UNRESOLVED — the bundle is missing libraries:"
	note "$missing"
	fail=1
fi

# 2. Every resolved dependency is a distro file.
unowned=""
foreign=""
while read -r _ _ path _; do
	case "$path" in
	""|"("*) continue ;;                       # vdso and the loader line
	esac
	[ -e "$path" ] || continue
	real=$(readlink -f "$path")
	case "$(dirname "$real")" in
	"$BUNDLE_DIR") continue ;;                 # our own prefix
	esac
	if ! dpkg -S "$real" >/dev/null 2>&1; then
		# A symlink dpkg does not track can still point at a file it does.
		if ! dpkg -S "$path" >/dev/null 2>&1; then
			unowned="$unowned$path -> $real"$'\n'
			continue
		fi
	fi
	case "$real" in
	/usr/local/*|/opt/*|"$HOME"/*) foreign="$foreign$path -> $real"$'\n' ;;
	esac
done <<<"$out"

if [ -n "$unowned" ]; then
	echo "CASCADE — these are not distro packages:"
	note "${unowned%$'\n'}"
	echo "  The bundle may only depend on the stock stack. Bundling what these provide is"
	echo "  the cascade this project exists to avoid — pick a GTK version that does not"
	echo "  need them (see the Makefile's gtk target)."
	fail=1
fi
if [ -n "$foreign" ]; then
	echo "CASCADE — these resolve outside the distro's prefixes:"
	note "${foreign%$'\n'}"
	fail=1
fi

# 3. The three the version cascade actually turns on, named explicitly so the failure
#    says which one moved rather than leaving it to be inferred from a path list.
for soname in libglib-2.0.so.0 libpango-1.0.so.0 libcairo.so.2; do
	line=$(grep -F "$soname =>" <<<"$out" | head -1)
	if [ -z "$line" ]; then
		echo "MISSING — the bundle does not link $soname at all; has the build changed?"
		fail=1
		continue
	fi
	path=$(awk '{print $3}' <<<"$line")
	if ! dpkg -S "$(readlink -f "$path")" >/dev/null 2>&1 && ! dpkg -S "$path" >/dev/null 2>&1; then
		echo "CASCADE — $soname resolves to $path, which no package owns"
		fail=1
	fi
done

if [ "$fail" -ne 0 ]; then
	exit 1
fi

n=$(grep -c "=>" <<<"$out")
echo "no-cascade OK — $n dependencies, all from distro packages"
